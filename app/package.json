{
  "name": "probaho-browser",
  "version": "2.2.0",
  "description": "Probaho Browser",
  "desktopName": "probaho-browser",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:tracker": "node --test tests/tracker-protection.test.js",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "perf:smoke": "npm run build && xvfb-run --auto-servernum --server-args='-screen 0 1440x900x24' node scripts/performance-smoke.mjs",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux --publish never",
    "checksums": "node scripts/create-checksums.mjs",
    "sbom": "npm --loglevel silent sbom --sbom-format cyclonedx --sbom-type application",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "build:all": "electron-builder --win --linux --x64"
  },
  "build": {
    "appId": "com.susankarkarmakar.probaho",
    "productName": "Probaho Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Probaho Browser"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "13.0.0"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Network",
      "syncDesktopName": true,
      "maintainer": "Susankar Karmakar <your-email@example.com>",
      "vendor": "Susankar Karmakar",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "susankarkarmakar-pixel",
      "repo": "probaho-browser"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.292.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "shell-quote": "1.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.62.1",
    "typescript": "^5.2.2",
    "vite": "6.4.3",
    "wait-on": "^7.2.0"
  },
  "homepage": "https://github.com/susankarkarmakar-pixel/probaho-browser",
  "author": "Susankar Karmakar <susankar@example.com>"
}
